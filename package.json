{
  "name": "sigma-presensi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server.ts",
    "dev:client": "npm --prefix views run dev",
    "db:migrate": "tsx database/migrate.ts",
    "db:seed": "tsx database/seeds/seedUsers.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "npm --prefix views run build",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:seed:attendance": "tsx database/seeds/seedAttendance.ts",
    "db:seed:peserta": "tsx database/seeds/seedPeserta.ts"
  },
  "dependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/pg": "^8.23.1",
    "argon2": "^0.45.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
