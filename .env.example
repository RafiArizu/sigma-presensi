# SIGMA - environment template
# Jangan isi nilai rahasia di file ini dan jangan commit file .env.

NODE_ENV=development
PORT=4000

# Frontend development origin. Vite proxy forwards /api to Express.
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL local
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sigma_presensi
PGUSER=postgres
PGPASSWORD=

# Server-side session cookie
SESSION_COOKIE_NAME=sigma_session
SESSION_SECRET=
SESSION_LIFETIME_MINUTES=120
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# CSRF and rate-limit defaults for development
CSRF_COOKIE_NAME=sigma_csrf
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX_REQUESTS=10

# Private evidence storage; local implementation may use a non-public directory.
PRIVATE_STORAGE_DRIVER=local
PRIVATE_STORAGE_PATH=storage/private

# Operational timezone must be confirmed before pilot.
OPERATING_TIMEZONE=Asia/Jakarta

# Logging
TRUST_PROXY=false
LOG_LEVEL=debug





