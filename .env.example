# SIGMA - environment template
# Jangan isi nilai rahasia di file ini dan jangan commit file .env.

NODE_ENV=development
PORT=4000

# Frontend development origin. Vite proxy forwards /api to Express.
FRONTEND_ORIGIN=http://localhost:5173

# MySQL Laragon / local MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sigma_presensi
MYSQL_USER=root
MYSQL_PASSWORD=

# Server-side session cookie
SESSION_COOKIE_NAME=sigma_session
SESSION_SECRET=
SESSION_LIFETIME_MINUTES=120
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# CSRF and rate-limit defaults for development
CSRF_COOKIE_NAME=sigma_csrf
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Face recognition adapter
# Leave disabled until the 1:1 PoC and provider/model decision are approved.
FACE_ENGINE=disabled
FACE_ENGINE_URL=
FACE_ENGINE_API_KEY=
FACE_MODEL_VERSION=
FACE_THRESHOLD=
FACE_LIVENESS_ENABLED=false

# Private evidence storage; local implementation may use a non-public directory.
PRIVATE_STORAGE_DRIVER=local
PRIVATE_STORAGE_PATH=storage/private

# Operational timezone must be confirmed before pilot.
OPERATING_TIMEZONE=Asia/Jakarta

# Logging
LOG_LEVEL=debug
